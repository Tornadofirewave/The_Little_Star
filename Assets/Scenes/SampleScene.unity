  m_Script: {fileID: 11500000, guid: 0cd4159bb0a30964fa45b1f125fd4567, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - Welcome to A Little Star.
  - The goal is to go up. As far as you can.
  - Reach for the stars type shi.
  - These red bubbles right here?
  - They give you a boost.
  - There are green bubbles too.
  - They're required to progress. Just gotta touch em.
  - You can also throw a star (press X) to help reach bubbles.
  - The movement key you press influences where the star goes.
  - Good luck.
  repeatLine: Test4
  interactKey: 273
